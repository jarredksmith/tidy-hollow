{
  "name": "tidy-hollow-coach",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://jarredksmith.github.io",
    "GEMINI_MODEL": "REPLACE_WITH_ENABLED_VISION_MODEL"
  },
  "ratelimits": [
    {"name": "RATE_LIMITER", "namespace_id": "10421011", "simple": {"limit": 6, "period": 60}}
  ],
  "observability": {"enabled": false}
}
